%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 7057a16be2d77dd4fa0366c56605ed7f, type: 3}
  m_Name: 10
  m_EditorClassIdentifier: 
  lines:
  - speaker: Charlie
    text: "Sam!! Can you hear me now? I don\u2019t see any more of those robot things
      \u2026 Did I complete the game?"
    portrait: {fileID: 21300000, guid: 08564b482b2f0ec4286cc4ec282dcac6, type: 3}
    voiceClip: {fileID: 8300000, guid: 86fe20e6fc8a1d340a4741c7c62b7b69, type: 3}
  - speaker: Sam
    text: "\u2026 You made it this far? Why would <i>you</i> do that!?\r\n"
    portrait: {fileID: 21300000, guid: 3e79683301d7d4141b9978185e85cfe3, type: 3}
    voiceClip: {fileID: 8300000, guid: bcafeccd22db75749b36eb67d0bb98a7, type: 3}
  - speaker: Charlie
    text: 'Sam! You can hear me! '
    portrait: {fileID: 21300000, guid: 08564b482b2f0ec4286cc4ec282dcac6, type: 3}
    voiceClip: {fileID: 8300000, guid: d365a38dab7c2354ebd657010e1ee2ce, type: 3}
  - speaker: Charlie
    text: "Wait, what are you talking about?! You\u2019ve been missing!"
    portrait: {fileID: 21300000, guid: adb9a9e81cb343a4886309d9774e6689, type: 3}
    voiceClip: {fileID: 8300000, guid: 86fe20e6fc8a1d340a4741c7c62b7b69, type: 3}
  - speaker: Sam
    text: "\u2026"
    portrait: {fileID: 21300000, guid: 93443cf9059553c40926eeb200fdd2b1, type: 3}
    voiceClip: {fileID: 0}
  - speaker: Sam
    text: ' If you really cared, why didn''t you come earlier? You never visited,
      not once in three years.'
    portrait: {fileID: 21300000, guid: 3e79683301d7d4141b9978185e85cfe3, type: 3}
    voiceClip: {fileID: 8300000, guid: bcafeccd22db75749b36eb67d0bb98a7, type: 3}
  - speaker: Charlie
    text: "\u2026"
    portrait: {fileID: 21300000, guid: adb9a9e81cb343a4886309d9774e6689, type: 3}
    voiceClip: {fileID: 0}
  - speaker: Charlie
    text: "I know you\u2019re upset, but this isn\u2019t safe. You should come back
      home.\r"
    portrait: {fileID: 21300000, guid: 08564b482b2f0ec4286cc4ec282dcac6, type: 3}
    voiceClip: {fileID: 8300000, guid: d365a38dab7c2354ebd657010e1ee2ce, type: 3}
  - speaker: Sam
    text: "\u2026 Did you have fun at college? I mean, you being here just makes
      me feel worse. "
    portrait: {fileID: 21300000, guid: 3b9c02af5ed51e942b0cc467f6452a81, type: 3}
    voiceClip: {fileID: 8300000, guid: bcafeccd22db75749b36eb67d0bb98a7, type: 3}
  - speaker: Sam
    text: "All they do is talk about <i>you</i> , it\u2019s always about <i>you</i>.
      They want me to be like you, just as smart, just like a copy."
    portrait: {fileID: 21300000, guid: 3e79683301d7d4141b9978185e85cfe3, type: 3}
    voiceClip: {fileID: 8300000, guid: bcafeccd22db75749b36eb67d0bb98a7, type: 3}
  - speaker: Charlie
    text: "Listen, we can talk about everything later, it isn\u2019t safe being here
      like this! Let\u2019s get out of here!\r"
    portrait: {fileID: 21300000, guid: adb9a9e81cb343a4886309d9774e6689, type: 3}
    voiceClip: {fileID: 8300000, guid: 86fe20e6fc8a1d340a4741c7c62b7b69, type: 3}
  - speaker: Sam
    text: "You still don\u2019t get it! Why don\u2019t you just leave and go back
      to your life? You clearly didn\u2019t care enough earlier, so why come looking
      now."
    portrait: {fileID: 21300000, guid: 3e79683301d7d4141b9978185e85cfe3, type: 3}
    voiceClip: {fileID: 8300000, guid: bcafeccd22db75749b36eb67d0bb98a7, type: 3}
  - speaker: Sam
    text: "Even if I explain everything, you wouldn\u2019t understand. Cause if you
      did, maybe you wouldn\u2019t have left me alone to deal with them. "
    portrait: {fileID: 21300000, guid: 3b9c02af5ed51e942b0cc467f6452a81, type: 3}
    voiceClip: {fileID: 8300000, guid: bcafeccd22db75749b36eb67d0bb98a7, type: 3}
  - speaker: Sam
    text: "Just get out. I don\u2019t want to see you, or anyone else. <i> Just leave
      me alone. </i> "
    portrait: {fileID: 21300000, guid: 3e79683301d7d4141b9978185e85cfe3, type: 3}
    voiceClip: {fileID: 8300000, guid: bcafeccd22db75749b36eb67d0bb98a7, type: 3}
  pausesCombat: 1
