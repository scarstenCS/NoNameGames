  m_Script: {fileID: 11500000, guid: 7057a16be2d77dd4fa0366c56605ed7f, type: 3}
  m_Name: 10
  m_EditorClassIdentifier: 
  lines:
  - speaker: Charlie
    text: "Sam!! Can you hear me now? I don\u2019t see any more of those robot things\u2026"
    portrait: {fileID: 21300000, guid: 08564b482b2f0ec4286cc4ec282dcac6, type: 3}
  - speaker: ???
    text: "It doesn\u2019t matter anymore."
    portrait: {fileID: 21300000, guid: fa7584bf52c3f9c4aa3c0e70e93cfac3, type: 3}
  - speaker: Charlie
    text: What are you talking about!?
    portrait: {fileID: 21300000, guid: 08564b482b2f0ec4286cc4ec282dcac6, type: 3}
  - speaker: ???
    text: "What did you come back here for? Did you just want to rub it in my face,
      that you\u2019re doing just fine and your life is so much better now\u2014
      while I\u2019m stuck here, stupid as ever? "
    portrait: {fileID: 21300000, guid: fa7584bf52c3f9c4aa3c0e70e93cfac3, type: 3}
  - speaker: Charlie
    text: 'Huh? What?? No!! '
    portrait: {fileID: 21300000, guid: 08564b482b2f0ec4286cc4ec282dcac6, type: 3}
  - speaker: ???
    text: "Why don\u2019t you just leave and go back to your life. No one cared when
      I was around before, so why come looking now? You, and everyone else\u2026  "
    portrait: {fileID: 21300000, guid: fa7584bf52c3f9c4aa3c0e70e93cfac3, type: 3}
  - speaker: ???
    text: 'Just leave me alone! '
    portrait: {fileID: 21300000, guid: fa7584bf52c3f9c4aa3c0e70e93cfac3, type: 3}
  pausesCombat: 1
