  m_Script: {fileID: 11500000, guid: 7057a16be2d77dd4fa0366c56605ed7f, type: 3}
  m_Name: 10
  m_EditorClassIdentifier: 
  lines:
  - speaker: Charlie
    text: Sam!! Can you hear me now??
    portrait: {fileID: 21300000, guid: 08564b482b2f0ec4286cc4ec282dcac6, type: 3}
  - speaker: ???
    text: "It doesn\u2019t matter anymore."
    portrait: {fileID: 0}
  - speaker: Charlie
    text: What is he talking about!?
    portrait: {fileID: 21300000, guid: 08564b482b2f0ec4286cc4ec282dcac6, type: 3}
  - speaker: ???
    text: "What did you come back here for? Did you just want to rub it in my face,
      that you\u2019re doing just fine and your life is so much better now\u2014
      while I\u2019m stuck here, stupid as ever? "
    portrait: {fileID: 0}
  - speaker: ???
    text: "Why don\u2019t you just leave and go back to your life. No one cared when
      I was around before, so why come looking now?"
    portrait: {fileID: 0}
  - speaker: ???
    text: You, and everyone else, just leave me alone.
    portrait: {fileID: 0}
  - speaker: ???
    text: You and everyone else have never understood what I needed.
    portrait: {fileID: 0}
  - speaker: ???
    text: You and everyone else just end up leaving me. I will never forgive you.
    portrait: {fileID: 0}
  - speaker: ???
    text: "You and everyone else, I don\u2019t want to see you after you abandoned
      me"
    portrait: {fileID: 0}
  - speaker: ???
    text: No one ever cared about me. You probably just want to rub it in my face
      that I am a disgrace. Just LEAVE ME ALONE
    portrait: {fileID: 0}
  pausesCombat: 1
