  lines:
  - speaker: Charlie
    text: "Woah! What happened to the parking lot? \r"
    portrait: {fileID: 21300000, guid: 08564b482b2f0ec4286cc4ec282dcac6, type: 3}
    voiceClip: {fileID: 8300000, guid: 86fe20e6fc8a1d340a4741c7c62b7b69, type: 3}
  - speaker: ???
    text: "\u2026I can\u2019t do anything\u2026"
    portrait: {fileID: 21300000, guid: 6fe3e72dfe6a3854a82a770fbb32a13c, type: 3}
    voiceClip: {fileID: 8300000, guid: bcafeccd22db75749b36eb67d0bb98a7, type: 3}
  - speaker: ???
    text: Why am I like this? Is there something wrong with me?
    portrait: {fileID: 21300000, guid: 6fe3e72dfe6a3854a82a770fbb32a13c, type: 3}
    voiceClip: {fileID: 8300000, guid: bcafeccd22db75749b36eb67d0bb98a7, type: 3}
  - speaker: Charlie
    text: "Sam! Where are you! What are you talking about?!\r"
    portrait: {fileID: 21300000, guid: 08564b482b2f0ec4286cc4ec282dcac6, type: 3}
    voiceClip: {fileID: 8300000, guid: 86fe20e6fc8a1d340a4741c7c62b7b69, type: 3}
  - speaker: Charlie
    text: "Huh, his voice is getting clearer after each wave, I just need to get
      to the end\u2026 maybe he\u2019ll hear me then.\r\n"
    portrait: {fileID: 21300000, guid: 08564b482b2f0ec4286cc4ec282dcac6, type: 3}
    voiceClip: {fileID: 8300000, guid: d365a38dab7c2354ebd657010e1ee2ce, type: 3}
  pausesCombat: 1
