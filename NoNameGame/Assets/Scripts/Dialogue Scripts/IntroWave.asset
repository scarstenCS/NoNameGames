MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 7057a16be2d77dd4fa0366c56605ed7f, type: 3}
  m_Name: IntroWave
  m_EditorClassIdentifier: 
  lines:
  - speaker: Charlie
    text: "Judging from the game\u2019s description, there\u2019s only a limited
      time for me to find Sam. Hopefully this game leads me to him. "
    portrait: {fileID: 21300000, guid: 08564b482b2f0ec4286cc4ec282dcac6, type: 3}
    voiceClip: {fileID: 8300000, guid: 51ac8d4da9827144eb95c4f08e6621ef, type: 3}
  - speaker: Charlie
    text: "It seems like he used to be active on the site a lot, he has a lot of
      games. But, this game was privated for friends only.\r"
    portrait: {fileID: 21300000, guid: 11fc98ab0ca876a4f863234970e4a112, type: 3}
    voiceClip: {fileID: 8300000, guid: 51ac8d4da9827144eb95c4f08e6621ef, type: 3}
  - speaker: Charlie
    text: "Hmm, I don\u2019t think many people have entered this game besides me."
    portrait: {fileID: 21300000, guid: 11fc98ab0ca876a4f863234970e4a112, type: 3}
    voiceClip: {fileID: 8300000, guid: 51ac8d4da9827144eb95c4f08e6621ef, type: 3}
  - speaker: Charlie
    text: " \u2026\r"
    portrait: {fileID: 21300000, guid: 29d575551079f7240ac19caea91ac814, type: 3}
    voiceClip: {fileID: 0}
  - speaker: Charlie
    text: "I hope he\u2019s safe\u2026 he\u2019s never done something like this before.\r\n"
    portrait: {fileID: 21300000, guid: 08564b482b2f0ec4286cc4ec282dcac6, type: 3}
    voiceClip: {fileID: 8300000, guid: d365a38dab7c2354ebd657010e1ee2ce, type: 3}
  - speaker: Charlie
    text: "Looks like the game\u2019s starting, I should stay focused. "
    portrait: {fileID: 21300000, guid: 08564b482b2f0ec4286cc4ec282dcac6, type: 3}
    voiceClip: {fileID: 8300000, guid: d365a38dab7c2354ebd657010e1ee2ce, type: 3}
  pausesCombat: 1
