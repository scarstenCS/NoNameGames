--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 7057a16be2d77dd4fa0366c56605ed7f, type: 3}
  m_Name: IntroWave
  m_EditorClassIdentifier: 
  lines:
  - speaker: Charlie
    text: "A parking lot? Why would Sam post a picture in this place..?\r"
    portrait: {fileID: 21300000, guid: 51f26c653d61e7c44ae636d3dc0df40a, type: 3}
    voiceClip: {fileID: 8300000, guid: 4903289c394635f4f9226ba88ab80b9e, type: 3}
  - speaker: Charlie
    text: "Hopefully there\u2019s some sort of clue that I can use in his last post\u2026"
    portrait: {fileID: 21300000, guid: 08564b482b2f0ec4286cc4ec282dcac6, type: 3}
    voiceClip: {fileID: 8300000, guid: 4903289c394635f4f9226ba88ab80b9e, type: 3}
  - speaker: Charlie
    text: "It seems like he used to post a lot, then it dwindled down with this being
      one of the last areas he was in. \r"
    portrait: {fileID: 21300000, guid: 6dea22f8c3b2d4a4e9b766ae7f59f275, type: 3}
    voiceClip: {fileID: 8300000, guid: 4903289c394635f4f9226ba88ab80b9e, type: 3}
  - speaker: Charlie
    text: "I don\u2019t think many people have entered the post besides me.\r"
    portrait: {fileID: 21300000, guid: 6dea22f8c3b2d4a4e9b766ae7f59f275, type: 3}
    voiceClip: {fileID: 0}
  - speaker: Charlie
    text: "\u2026"
    portrait: {fileID: 21300000, guid: 51f26c653d61e7c44ae636d3dc0df40a, type: 3}
    voiceClip: {fileID: 0}
  - speaker: Charlie
    text: "I hope he\u2019s safe\u2026"
    portrait: {fileID: 21300000, guid: 08564b482b2f0ec4286cc4ec282dcac6, type: 3}
    voiceClip: {fileID: 0}
  - speaker: Charlie
    text: "Ugh! There\u2019s more of those things? Where are they coming from?!\r"
    portrait: {fileID: 21300000, guid: adb9a9e81cb343a4886309d9774e6689, type: 3}
    voiceClip: {fileID: 0}
  pausesCombat: 1
