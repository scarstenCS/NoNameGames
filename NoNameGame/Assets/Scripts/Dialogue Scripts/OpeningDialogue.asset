  lines:
  - speaker: Charlie
    text: A parking lot? Alright, I can work with this. I just need to find the name
      of the store.
    portrait: {fileID: 21300000, guid: 9589ba998a31dac4898c1cbb35cc2718, type: 3}
  - speaker: Charlie
    text: What's this?
    portrait: {fileID: 21300000, guid: 51f26c653d61e7c44ae636d3dc0df40a, type: 3}
  - speaker: Charlie
    text: "Isn\u2019t this Sam\u2019s boomerang\u2026? I haven\u2019t seen this in
      years. I\u2019ll have to give it back once I find him."
    portrait: {fileID: 21300000, guid: 08564b482b2f0ec4286cc4ec282dcac6, type: 3}
  - speaker: Charlie
    text: "Is that a person? That can\u2019t be right. The app only allows one person
      inside virtual worlds.."
    portrait: {fileID: 21300000, guid: 9589ba998a31dac4898c1cbb35cc2718, type: 3}
  - speaker: Charlie
    text: Umm.. is it approaching me?!
    portrait: {fileID: 21300000, guid: 08564b482b2f0ec4286cc4ec282dcac6, type: 3}
  pausesCombat: 1
